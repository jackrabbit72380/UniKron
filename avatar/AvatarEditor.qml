import QtQuick 2.15

// The avatar editor.
//
// Point `assetsFolder` at a directory of category folders and it works out
// everything else by itself: each folder is a category, its images are the
// items, and a numeric prefix on the folder name is the layer order.
//
//   assets/10_body/      body_light.png ...
//   assets/20_pants/     jeans_indigo.png, shorts_khaki.png ...
//   assets/40_shirt/     tee_blue.png ...
//
// The folder contents come from AssetIndex.qml, which avatar_tools/
// watch_art.ps1 rewrites whenever the art folders change (install_watcher.bat
// starts it at login): Qt.labs.folderlistmodel is not part of the Pegasus
// builds, so nothing can list a directory at runtime. Add art, press F5.
// Folders whose name starts with _ or . are skipped, which is where the
// editor's own chrome lives, and a numeric prefix on the folder name is the
// layer order. Every drawing uses the same 512x768 canvas, so items never need
// position data.
Item {
    id: root

    AssetIndex { id: assetIndex }
    // The pack's own items: one render per real AvatarAssetPack asset, written by
    // avatar_tools/bake_pack_thumbs.py together with this index.
    PackIndex { id: packIndex }
    PackPlates { id: packPlates }
    // The female half of the pack's art. Same categories, but every item baked on
    // FemaleBody (bake_pack_plates.py / bake_pack_turntables.py --gender female),
    // because a female garment drawn on a male body is not the same picture.
    PackPlatesFemale { id: packPlatesFemale }
    // The tint masks and the colour tables, both generated by
    // avatar_tools/make_colour_qml.py.
    PackMasks { id: packMasks }
    Colours { id: colourTables }
    // Item slug -> the pack's own gender byte, so the strip can offer only what
    // this avatar can wear.
    PackGenders { id: packGenders }

    Style { id: style }

    // ---- what the host can set -------------------------------------------
    property url assetsFolder: Qt.resolvedUrl("assets/")
    // Where the pack-derived thumbnails live, and whether the wardrobe browses
    // them instead of the hand-drawn art in assets/. Off by default: the drawn art
    // is what the 3D wardrobe is keyed against.
    property url packArtFolder: Qt.resolvedUrl("pack_art/")
    // Aligned 2D plates for the pack's items, baked by bake_pack_plates.py: one
    // render per item through the body's own frame, so layers stack into a single
    // avatar instead of each item being framed on its own.
    // Which body the avatar is. The pack stores this per item, and the two bodies
    // have separate bakes, so this switches the art as well as the seed outfit.
    property string gender: "male"
    // Switching bodies drops the outfit that belonged to the other one: the body
    // and the four seeded slots are cleared and reseeded, accessories stay unless
    // the new body cannot wear them (pruneState decides that).
    onGenderChanged: {
        var next = {}
        for (var key in state) {
            if (key.indexOf("body") >= 0 || key.indexOf("shirt") >= 0
                    || key.indexOf("pants") >= 0 || key.indexOf("shoes") >= 0
                    || (key.indexOf("hair") >= 0 && key.indexOf("facial") < 0))
                continue
            next[key] = state[key]
        }
        state = next
        rebuildCategories()
        rebuildLayers()
    }

    // Read through functions, not bindings: a gender switch runs its rebuild
    // inside the change handler, and a binding that has not been re-evaluated yet
    // still answers with the old gender's art.
    function platesIndex() {
        return gender === "female" ? packPlatesFemale : packPlates
    }

    function plateFolder() {
        return Qt.resolvedUrl(gender === "female" ? "pack_plates_female/" : "pack_plates/")
    }

    // The baked 3D sets follow the same split: assets/3d/turntable_female/.
    function turntableFolder() {
        return gender === "female" ? "turntable_female" : "turntable"
    }

    property url packPlateFolder: plateFolder()
    readonly property string turntableRoot: turntableFolder()
    readonly property var activePlates: platesIndex()
    // The closet browses the pack's own items. Every one of them has a plate and
    // a baked set (740 of 743; the three left are the base body and head), and
    // the pack is the retail content - the theme's eight drawn categories are the
    // port's fallback, not the thing this editor is reproducing.
    property bool usePackArt: true
    property string gamerTag: "Player"
    // The original editor's own wording for this screen: the string table of
    // scnEditor in avatareditor.xex holds exactly this sentence.
    property string title: "Choose an avatar as a starting point"

    // The one colour the chrome takes from its host, so the editor can sit in
    // another theme's palette; items and the stage are unaffected.
    property color accentColor: style.accent
    property color accentInkColor: style.inkOnCard

    // category id -> chosen image file name, e.g. { "20_pants": "jeans_indigo.png" }
    property var state: ({})

    // palette slot -> index into that slot's table, e.g. { "eyebrow": 15 }. A slot
    // that is not listed keeps the table's first colour, which is the one the stock
    // avatar was saved with.
    property var colours: ({})

    // ---- what the host can read ------------------------------------------
    property var categories: []          // [{ id, label, path, z }]
    property int categoryIndex: 0

    // ---- screens ---------------------------------------------------------
    // The original editor opens on a menu: the avatar on the left and five
    // plates down the right — Change My Features, Change My Clothes, Gamer
    // Picture, Start Over, Save and Exit — with the selected plate in lime.
    // "Change My Clothes" opens the closet. The plate art is the editor's own,
    // taken out of avatareditor.xex as selected/unselected pairs, with the
    // icon already baked into the left side of each plate.
    property string screen: "menu"

    readonly property var menuItems: [
        { key: "features", label: "Change My Features" },
        { key: "clothes",  label: "Change My Clothes" },
        { key: "picture",  label: "Gamer Picture" },
        { key: "start",    label: "Start Over" },
        { key: "exit",     label: "Save and Exit" }
    ]
    property int menuIndex: 1

    // "Change My Features" is its own screen in the source: six 360x200 tiles,
    // each a rendered close-up of the thing you are changing, lime when picked
    // and grey-blue when not. The art is the editor's own out of the XEX.
    readonly property var featureItems: [
        { key: "earrings", label: "Earrings" },
        { key: "eyes",     label: "Eyes" },
        { key: "facial",   label: "Facial Hair" },
        { key: "skin",     label: "Skin" },
        { key: "glasses",  label: "Glasses" },
        { key: "lips",     label: "Lips" }
    ]
    property int featureIndex: 0

    // "Choose an avatar as a starting point": scnEditor registers ten avatar
    // buttons (AvatarButton1..10) and a refresh-random override, and its VECT
    // chunk puts nine of them on one row at 62.39, 152.28, 242.17, 332.06,
    // 420.94, 510.83, 600.72, 690.61 and 780.50 — 89.89 apart on the 960-wide
    // surface, with the tenth slot at the end. That row is what this screen is.
    property var presets: []
    property int chooseIndex: 0

    readonly property var chooseSlots: [
        62.39, 152.28, 242.17, 332.06, 420.94, 510.83, 600.72, 690.61, 780.50, 870.39
    ]

    function rebuildPresets() {
        var out = []
        // A thumbnail stacks layers, so it can only use art that is registered to
        // the body frame: the plates. pack_art is not that art - each file there is
        // an item on its own (an untextured grey mesh, or a head close-up for the
        // shape overrides), and stacking those drew grey blobs with red marks on
        // the choose screen. The pool is therefore every slot that has plates,
        // minus the face sheets (decals on the head) and the shape overrides
        // (morphs, which no layer stack can express).
        var pool = []
        for (var c = 0; c < categories.length; ++c) {
            var cat = categories[c]
            if (!cat || !cat.id || (bodyCategory && cat.id === bodyCategory.id))
                continue
            if (isPackDecal(cat.id) || cat.id === "18_mouth")
                continue
            var files = usePackArt ? plateFiles(cat.id) : (cat.files || [])
            if (files.length)
                pool.push({ id: cat.id, files: files })
        }
        var body = (usePackArt && bodyCategory) ? plateFiles(bodyCategory.id)
                 : (bodyCategory ? (bodyCategory.files || []) : [])
        for (var i = 0; i < chooseSlots.length; ++i) {
            var preset = {}
            if (body.length && bodyCategory)
                preset[bodyCategory.id] = body[i % body.length]
            // The retail starting points are dressed, not random piles: every one
            // wears trousers, shoes and a top. Those three are filled first, then
            // hair, then the accessories on a coin flip, so the ten read as ten
            // people rather than ten bare chests with a random hat.
            var required = ["20_pants", "30_shoes", "40_shirt", "50_hair"]
            for (var r = 0; r < required.length; ++r) {
                for (var q = 0; q < pool.length; ++q) {
                    if (pool[q].id === required[r]) {
                        preset[pool[q].id] = pool[q].files[Math.floor(Math.random() * pool[q].files.length)]
                        break
                    }
                }
            }
            for (var p = 0; p < pool.length; ++p) {
                if (preset[pool[p].id])
                    continue
                if (Math.random() < 0.3)
                    preset[pool[p].id] = pool[p].files[Math.floor(Math.random() * pool[p].files.length)]
            }
            out.push(preset)
        }
        presets = out
    }

    function applyPreset(index) {
        var preset = presets[index]
        if (!preset)
            return
        var next = {}
        for (var key in preset)
            next[key] = preset[key]
        state = next
        rebuildLayers()
        setScreen("menu")
    }

    // The source draws one legend per screen: the menu offers A Select (the
    // preview screenshot shows exactly that), the closet needs its four.
    readonly property var legendModel: screen === "closet"
        ? [ { glyph: "assets/_ui/xex/legend_a.png", label: "Save", action: "save" },
            { glyph: "assets/_ui/xex/legend_b.png", label: "Back", action: "back" },
            { glyph: "assets/_ui/xex/legend_x.png", label: "Randomize", action: "randomize" },
            { glyph: "assets/_ui/xex/legend_y.png", label: "Portrait", action: "portrait" } ]
        : (screen === "choose"
           ? [ { glyph: "assets/_ui/xex/legend_a.png", label: "Select", action: "menuSelect" },
               { glyph: "assets/_ui/xex/legend_b.png", label: "Back", action: "back" },
               { glyph: "assets/_ui/xex/legend_x.png", label: "Refresh", action: "presets" } ]
           : [ { glyph: "assets/_ui/xex/legend_a.png", label: "Select", action: "menuSelect" },
               { glyph: "assets/_ui/xex/legend_b.png", label: "Back", action: "back" } ])

    function setScreen(name) { screen = name }

    // The ten starting avatars are built from the active wardrobe, so a caller
    // that opens this screen without going through loadState() (a host, a test
    // harness) used to get an empty row - the screen read as broken while the
    // editor was fine. Build them the first time the screen is shown.
    onScreenChanged: {
        if (screen === "choose" && presets.length === 0)
            rebuildPresets()
    }

    // A feature tile only opens something when a folder covers it; the rest are
    // the source's tiles with no items to show, which is what it does too when
    // the player owns nothing.
    function categoryIndexFor(label) {
        for (var i = 0; i < categories.length; ++i) {
            if (String(categories[i].label).toLowerCase() === String(label).toLowerCase())
                return i
        }
        return -1
    }

    function categoryIndexForId(id) {
        for (var i = 0; i < categories.length; ++i) {
            if (String(categories[i].id) === String(id))
                return i
        }
        return -1
    }

    // Two of the six feature tiles name their subject in the XUI's words, not the
    // pack's: the scene says "Skin" and "Lips", while the items live in the slots
    // the pack files them under, so a label match alone leaves those tiles
    // opening nothing. The keys are featureItems keys, the values the slot the
    // pack's own contents put that subject in - 10_body carries the body and
    // head, 18_mouth the mouths. Eyes needs no entry: 15_face is every *-eyes
    // sheet, so its slot is labelled "Eyes" and matches on its own.
    readonly property var featureSlots: ({
        "skin": "10_body",
        "lips": "18_mouth"
    })

    function activateFeature(index) {
        var item = featureItems[index]
        if (!item)
            return
        var at = categoryIndexFor(item.label)
        if (at < 0 && featureSlots[item.key] !== undefined)
            at = categoryIndexForId(featureSlots[item.key])
        if (at < 0)
            return
        categoryIndex = at
        setScreen("closet")
    }

    function activateMenuItem(index) {
        var item = menuItems[index]
        if (!item)
            return
        switch (item.key) {
        case "features": setScreen("features"); break
        case "clothes":  setScreen("closet"); break
        case "picture": capturePortrait(); break
        case "start":   clearAll(); break
        case "exit":    save(); break
        }
    }
    // The hairstyle picked in the closet picks the baked 3D set: bake_outfits.py
    // writes one folder per file in assets/50_hair, named after that file.
    readonly property string hairVariant: {
        for (var i = 0; i < categories.length; ++i) {
            var c = categories[i]
            // 45_facial-hair also contains "hair": only the hairstyle category
            // names a baked set.
            if (!c || !c.id || c.id.indexOf("hair") < 0 || c.id.indexOf("facial") >= 0)
                continue
            var file = state[c.id] || ""
            if (file !== "")
                return file.replace(/\.png$/i, "")
        }
        return ""
    }

    // Every wardrobe item that has its own baked turntable, and the folder its
    // set lives in: bake_items.py writes one folder per entry in
    // avatar_tools/items_3d.json as assets/3d/<kind>/<stem>.
    readonly property var bakedItems: ({
        "tee_blue": "shirts", "tee_white": "shirts", "tee_red": "shirts", "tee_black": "shirts",
        "hoodie_grey": "shirts", "hoodie_navy": "shirts", "hoodie_olive": "shirts", "hoodie_plum": "shirts",
        "jersey_green": "shirts", "jersey_red": "shirts", "jersey_blue": "shirts", "jersey_white": "shirts",
        "tank_white": "shirts", "tank_black": "shirts", "tank_blue": "shirts", "tank_pink": "shirts",
        "coat_navy": "shirts", "coat_grey": "shirts", "coat_brown": "shirts", "coat_olive": "shirts",
        "jeans_indigo": "pants", "jeans_black": "pants", "jeans_grey": "pants",
        "joggers_black": "pants", "joggers_grey": "pants", "joggers_navy": "pants",
        "shorts_khaki": "pants", "shorts_black": "pants", "shorts_denim": "pants",
        "cargo_olive": "pants", "cargo_brown": "pants", "cargo_grey": "pants",
        "sneakers_white": "shoes", "sneakers_black": "shoes", "sneakers_navy": "shoes",
        "sneakers_green": "shoes", "trainers_red": "shoes",
        "boots_brown": "shoes", "boots_black": "shoes", "boots_tan": "shoes"
    })

    // The category the player last changed in the closet, so 3D shows the set for
    // the item they just picked rather than for whichever set sorts first.
    property string lastItemCategory: ""

    function categoryIdMatching(term) {
        for (var i = 0; i < categories.length; ++i) {
            var c = categories[i]
            if (!c || !c.id || c.id.indexOf(term) < 0 || c.id.indexOf("facial") >= 0)
                continue
            return c.id
        }
        return ""
    }

    // The baked set for whatever that category currently holds, or "" when there
    // is none - including the seeded default, which the stock bake already shows.
    function bakedSet(categoryId) {
        if (!categoryId)
            return ""
        // The body plates and face decals are the base layer and the skin, not
        // items: no set is baked for them, and picking one here would send the
        // stage to a folder that does not exist while a real garment is worn.
        if (categoryId.indexOf("body") >= 0 || categoryId.indexOf("face") >= 0)
            return ""
        var file = state[categoryId] || ""
        if (file === "")
            return ""
        for (var term in seedPicks) {
            if (categoryId.indexOf(term) >= 0 && seedPicks[term] === file)
                return ""
        }
        var stem = file.replace(/\.png$/i, "")
        var kind = bakedItems[stem]
        if (kind)
            return kind + "/" + stem
        // The pack's own items are baked as plain turntables under their slug
        // (bake_pack_turntables.py), not in items_3d.json. The stage probes for
        // frame_00 and falls back to the default set when a folder is missing,
        // so naming one here is safe even for the categories not baked yet.
        if (usePackArt)
            return turntableFolder() + "/" + stem
        return ""
    }

    // Which baked folder the 3D stage plays, relative to assets/3d/. The item
    // sets carry the default hairstyle, so they only apply while the player keeps
    // that hair; any other hairstyle falls back to its own turntable.
    readonly property string stageVariant: {
        var keepHair = hairVariant === "" || hairVariant === defaultHairStem
        if (keepHair) {
            var picked = bakedSet(lastItemCategory)
            if (picked !== "")
                return picked
            var order = ["shirt", "pants", "shoes"]
            for (var i = 0; i < order.length; ++i) {
                picked = bakedSet(categoryIdMatching(order[i]))
                if (picked !== "")
                    return picked
            }
        }
        // No trailing slash: the stage appends one, and "turntable//frame_00"
        // only works by luck of Qt normalising the path.
        var root = turntableFolder()
        return hairVariant === "" ? root : root + "/" + hairVariant
    }

    // The hairstyle seedOutfit fills in. bake_animated.py bakes the animated 3D
    // set for exactly this look, so those frames are only the right hair while
    // the player wears it (or has no hair picked at all).
    readonly property string defaultHairStem: {
        for (var i = 0; i < categories.length; ++i) {
            var c = categories[i]
            if (!c || !c.files || !c.files.length)
                continue
            if (c.id.indexOf("hair") < 0 || c.id.indexOf("facial") >= 0)
                continue
            // The stock hairstyle seedOutfit picks, which is also the one
            // bake_animated.py bakes the animated set in. It has to be the seed
            // for the mode in use, or pack mode would compare the hair it seeded
            // against a drawn hairstyle and never match. Falling back to the
            // first file keeps this working if that art is ever removed.
            var stem = (usePackArt ? packSeedPicksFor(gender) : seedPicks)["hair"]
            if (stem && c.files.indexOf(stem) >= 0)
                return stem.replace(/\.png$/i, "")
            return c.files[0].replace(/\.png$/i, "")
        }
        return ""
    }

    readonly property var currentCategory:
        categoryIndex >= 0 && categoryIndex < categories.length ? categories[categoryIndex] : null
    readonly property var layers: _layers
    readonly property var bodyCategory: categories.length > 0 ? categories[0] : null

    // 2D stacks the source's own art layers; 3D plays a baked turntable of the
    // real mesh (see AvatarStage3D and avatar_tools/bake_turntable.py).
    property string renderMode: "2d"

    // avatareditor.toml's model_shadows, which the source ships switched on: the
    // soft shadow the avatar stands on. Kept in api.memory so it survives a
    // reopen, the way the original keeps its config between starts.
    property bool modelShadows: true
    // The avatar's idle motion (the 2D bob, the 3D pose timer). A host holds it
    // still when it needs two paintings of the same pose.
    property bool idleBob: true

    signal saveRequested(var state)
    signal portraitReady(var grabResult)
    signal backRequested()

    // Authored size of the original closet (avatareditor.xex, scnEditor DATA
    // stores 960x720); the page scales this whole item to the window.
    implicitWidth: 960
    implicitHeight: 720
    focus: true

    property var _layers: []
    property int _layerVersion: 0

    // ---- discovery -------------------------------------------------------
    // Nothing here reads a directory: Qt.labs.folderlistmodel is not part of
    // the Pegasus builds and QML has no other way to list a folder, so the
    // contents of assets/ ship as data in AssetIndex.qml.

    ListModel { id: items }

    // The pack holds no body textures and no skin tones, so the body layer always
    // comes from the drawn plates even when the wardrobe browses the pack.
    function drawnBodyFolder() {
        for (var i = 0; i < assetIndex.folders.length; ++i) {
            if (assetIndex.folders[i].id === "10_body")
                return { path: style.dirUrl(root.assetsFolder, "10_body"),
                         files: assetIndex.folders[i].files || [] }
        }
        return null
    }

    function rebuildCategories() {
        var list = []
        var source = root.usePackArt ? packIndex.folders : assetIndex.folders
        var base = root.usePackArt ? root.packArtFolder : root.assetsFolder
        for (var i = 0; i < source.length; ++i) {
            var name = source[i].id
            if (!name || name.charAt(0) === "." || name.charAt(0) === "_")
                continue
            var folderPath = style.dirUrl(base, name)
            var folderFiles = source[i].files || []
            // The drawn body plates stand in for the pack's missing body art. Once
            // the pack has its own plates they win, because those are rendered
            // through the same frame as every item plate.
            if (root.usePackArt && name === "10_body") {
                if (hasPlates("10_body")) {
                    // Plate names have to be the ones the strip offers, or the
                    // chosen body is not in its own model and nothing highlights.
                    folderPath = style.dirUrl(root.plateFolder(), name)
                    folderFiles = plateFiles(name)
                } else {
                    var drawn = drawnBodyFolder()
                    if (drawn) {
                        folderPath = drawn.path
                        folderFiles = drawn.files
                    }
                }
            }
            // Only what this avatar can wear: the pack marks every item male or
            // female, and unmarked ones (the shared eye sheets, the hair the
            // pack marks both) belong to either.
            if (root.usePackArt) {
                var wearable = []
                for (var k = 0; k < folderFiles.length; ++k) {
                    var tag = packGenders.items[String(folderFiles[k]).replace(/\.png$/i, "")]
                    if (!tag || tag === root.gender || tag === "both")
                        wearable.push(folderFiles[k])
                }
                folderFiles = wearable
            }
            // Nothing this avatar can wear gets no rail entry. The pack marks
            // every dress female and the coats male, so 80_dress and
            // 83_dress-formal are empty for a male avatar and 82_coat is empty
            // for a female one: a pill that opens onto an empty strip is worse
            // than no pill.
            if (folderFiles.length === 0)
                continue
            list.push({
                id: name,
                label: style.slotLabel(name),
                path: folderPath,
                files: folderFiles,
                z: style.layerOrder(name)
            })
        }
        list.sort(function (a, b) { return a.z - b.z })
        // Categories can drop out between genders (the dresses, the coats), so
        // `categoryIndex` cannot be carried over as a number: read the pill the
        // player is on *before* the list is replaced, then restore it by id and
        // clamp only when that id is gone.
        var keepId = currentCategory ? currentCategory.id : ""
        // Fix the picks against the new list *before* `categories` is replaced.
        // Assigning it notifies onCategoriesChanged, which rebuilds the 2D stack,
        // and that build used to run with the previous mode's picks against the
        // new mode's folders: switching the drawer to pack items asked the stage
        // for assets/20_pants/male-flower-print-flares.png (drawn folder, pack
        // name) and logged one failed load per seeded slot - measured 43 in a
        // switch cycle, before the state was corrected a line later.
        pruneState(list)
        seedOutfit(list)
        categories = list
        var keepAt = keepId !== "" ? categoryIndexForId(keepId) : -1
        if (keepAt >= 0)
            categoryIndex = keepAt
        else if (categoryIndex >= categories.length)
            categoryIndex = Math.max(0, categories.length - 1)
        // A gender switch prunes the other body away, so the empty body slot has
        // to be refilled here as well as on load.
        fillBodyIfEmpty()
        fillItems()
    }

    // Switching to the pack's items leaves picks behind that only exist as drawn
    // art ("hair_short_brown.png"), which would then be requested from
    // pack_art/ and fail. Drop those, but only where the category still exists,
    // so a wardrobe saved in one mode survives a round trip through the other.
    function pruneState(list) {
        // `list` is the category list being installed; rebuildCategories calls
        // this before replacing `categories`, so the layers never see a pick that
        // does not belong to the folder it is about to be drawn from.
        var source = list || categories
        var next = {}
        var changed = false
        for (var key in state) {
            var keep = state[key]
            for (var i = 0; i < source.length; ++i) {
                if (source[i].id !== key)
                    continue
                if ((source[i].files || []).indexOf(keep) < 0)
                    keep = ""
                break
            }
            if (keep)
                next[key] = keep
            else
                changed = true
        }
        if (changed)
            state = next
    }

    // A fresh avatar wears a stock outfit, the way the dashboard's does: without
    // this the first visit shows a player standing in nothing but a body layer
    // until they pick every garment by hand. Only empty slots are filled, so a
    // saved wardrobe is never overwritten.
    // The stock look the 3D sets are baked in, so a fresh avatar reads the same
    // in both modes instead of the 2D wardrobe opening on one outfit and the 3D
    // turntable wearing another.
    // The stock look the 3D bake wears, so both modes open as the same avatar:
    // Avatar6400's outfit (jacket, flares, trainers), tinted as in
    // avatar_tools/bake_avatar.py.
    readonly property var seedPicks: ({
        "shirt": "coat_navy.png",
        "pants": "jeans_indigo.png",
        "shoes": "sneakers_black.png",
        "hair": "hair_short_brown.png"
    })

    // The same look in the pack's own items: Avatar6400's descriptor, read by
    // avatar_tools/avatar_desc.py. Its look block names MaleBody, Head, Short
    // with Left Curls (Hat), Jacket with Sweater, Male Flower Print Flares and
    // Grunge Trainers - so a fresh pack avatar dresses the way the console's
    // sample avatar is dressed rather than in the first file of each category.
    // The hairstyle is the one exception: Avatar6400 wears `Short with Left
    // Curls (Hat)`, but that asset is a 102-vertex shell that sits inside the
    // skull, so it renders as a bald head (see CATALOG.md). The stock style is
    // used instead until that asset draws properly.
    function packSeedPicksFor(which) {
        return which === "female" ? ({
            // Avatar6404's descriptor: Sweater with Shirt, Formal Trouser Suit,
            // Female Jelly Clogs. The suit is a formal outfit (81_formal), not a
            // 20_pants item, so the pants slot seeds from its own category.
            "shirt": "sweater-with-shirt.png",
            "pants": "formal-trouser-suit.png",
            "shoes": "female-jelly-clogs.png",
            "hair": "shaved-pattern.png"
        }) : ({
            "shirt": "jacket-with-sweater.png",
            "pants": "male-flower-print-flares.png",
            "shoes": "grunge-trainers.png",
            "hair": "left-parting.png"
        })
    }

    readonly property var packSeedPicks: packSeedPicksFor(gender)

    function seedOutfit(list) {
        // Same reason as pruneState: the list being installed, not the one still
        // on screen.
        var source = list || categories
        var picks = usePackArt ? packSeedPicksFor(gender) : seedPicks
        var wanted = ["shirt", "pants", "shoes", "hair"]
        var next = {}
        var changed = false
        for (var held in state)
            next[held] = state[held]
        for (var i = 0; i < source.length; ++i) {
            var c = source[i]
            if (!c || !c.files || !c.files.length)
                continue
            for (var w = 0; w < wanted.length; ++w) {
                // 45_facial-hair is not the hairstyle category.
                if (c.id.indexOf(wanted[w]) < 0 || c.id.indexOf("facial") >= 0)
                    continue
                if (!next[c.id]) {
                    var pick = picks[wanted[w]]
                    next[c.id] = c.files.indexOf(pick) >= 0 ? pick : c.files[0]
                    changed = true
                }
            }
        }
        if (changed)
            state = next
    }

    // The strip shows one category at a time. A ListModel keeps the tiles'
    // fileName / filePath roles exactly as they were with a folder listing.
    function fillItems() {
        items.clear()
        // Read the category straight off the array, not through currentCategory:
        // this runs from the categoryIndex change handler, where that binding has
        // not been re-evaluated yet, so it would still hold the previous category
        // and leave the strip showing the wrong items.
        var cat = (categoryIndex >= 0 && categoryIndex < categories.length)
                  ? categories[categoryIndex] : null
        if (!cat)
            return
        var files = cat.files || []
        for (var i = 0; i < files.length; ++i)
            items.append({ fileName: files[i], filePath: style.itemUrl(cat.path, files[i]) })
        fillBodyIfEmpty()
    }

    onCategoryIndexChanged: fillItems()
    onAssetsFolderChanged: rebuildCategories()
    onPackArtFolderChanged: rebuildCategories()
    onUsePackArtChanged: rebuildCategories()

    function bodySource() {
        if (!bodyCategory)
            return ""
        var name = state[bodyCategory.id]
        return name ? style.itemUrl(bodyCategory.path, name) : ""
    }

    // ---- selection -------------------------------------------------------

    function setItem(categoryId, fileName) {
        var next = {}
        for (var key in state)
            next[key] = state[key]
        if (fileName) {
            next[categoryId] = fileName
        } else if (categoryId !== (bodyCategory ? bodyCategory.id : "")) {
            delete next[categoryId]
        }
        // Which set the 3D stage should show: the closet only has one baked
        // turntable per item, so it follows the piece the player just changed.
        lastItemCategory = categoryId
        state = next
        rebuildLayers()
    }

    function selectCategory(index) {
        if (index < 0 || index >= categories.length || index === categoryIndex)
            return
        categoryIndex = index
    }

    function moveItem(delta) {
        if (!items.count)
            return
        var id = currentCategory ? currentCategory.id : ""
        var chosen = state[id] || ""
        var at = -1
        for (var i = 0; i < items.count; ++i) {
            if (items.get(i).fileName === chosen) {
                at = i
                break
            }
        }
        var next = at + delta
        if (next < -1)
            next = -1
        if (next > items.count - 1)
            next = items.count - 1
        setItem(id, next < 0 ? "" : items.get(next).fileName)
    }

    // The body is the base layer and is never optional, so pick one whenever
    // there is none: on first open, and again when a host re-opens the editor
    // with an empty state, which wipes whatever Component.onCompleted chose.
    // It reads bodyCategory.files, not the strip's model, so it works whichever
    // category happens to be showing.
    function fillBodyIfEmpty() {
        if (!bodyCategory || state[bodyCategory.id])
            return
        var files = bodyCategory.files || []
        // Each gender's plates are posed on its own body, so open with the body
        // the current bake was made on.
        var body = gender === "female" ? "femalebody.png" : "malebody.png"
        if (usePackArt && files.indexOf(body) >= 0) {
            setItem(bodyCategory.id, body)
            return
        }
        for (var i = 0; i < files.length; ++i) {
            if (!files[i])
                continue
            setItem(bodyCategory.id, files[i])
            return
        }
    }

    // The pack's facial hair and face paint are UV sheets (128x64, 128x128), not
    // body plates: the stage fits every layer to the whole frame, so one of these
    // would stretch into a blurry decal over the entire avatar. The drawn art
    // for the same categories is real plate art (1024x1536), so this only
    // applies to pack mode. Where the sheets sit on the face is still unknown -
    // see avatar_tools/DECALS.md.
    //
    // 12_eyebrows belongs here for the same reason: its plates are the brow mask
    // baked onto the head (bake_pack_face.py), and the head is one asset shared by
    // both bodies, so the female avatar wears the male-baked brow plate.
    function isPackDecal(id) {
        return id === "12_eyebrows" || id === "15_face" || id === "16_face-paint"
                || id === "17_eye-shadow" || id === "45_facial-hair"
    }

    function plateFiles(categoryId) {
        var index = platesIndex()
        for (var i = 0; i < index.folders.length; ++i) {
            if (index.folders[i].id === categoryId)
                return index.folders[i].files || []
        }
        return []
    }

    function hasPlates(categoryId) {
        if (fileInPlates(platesIndex(), categoryId, "") !== null)
            return true
        // Both bodies share the one `Head` asset, so a face sheet plate baked on
        // the male head is the same picture on the female one.
        if (gender === "female" && isPackDecal(categoryId))
            return fileInPlates(packPlates, categoryId, "") !== null
        return false
    }

    // The file list for a category in an index, or null when it is not there.
    function fileInPlates(index, categoryId, name) {
        for (var i = 0; i < index.folders.length; ++i) {
            var f = index.folders[i]
            if (f.id !== categoryId)
                continue
            var files = f.files || []
            if (name === "")
                return files.length > 0 ? files : null
            return files.indexOf(name) >= 0 ? files : null
        }
        return null
    }

    // A plate for this item, if one was baked. Empty means there is none, and the
    // strip's own art has to serve.
    function plateUrl(categoryId, name) {
        if (fileInPlates(platesIndex(), categoryId, name) !== null)
            return style.itemUrl(style.dirUrl(plateFolder(), categoryId), name)
        // Face sheets are drawn on the shared head, so their plates are too.
        if (gender === "female" && isPackDecal(categoryId)
                && fileInPlates(packPlates, categoryId, name) !== null)
            return style.itemUrl(style.dirUrl(Qt.resolvedUrl("pack_plates/"), categoryId), name)
        return ""
    }

    // ---- colours ---------------------------------------------------------
    // Which palette tints each face category. The mapping is measured from the
    // bake: a brow mask times the eyebrow colour reproduces the coloured plate, so
    // does eye shadow times its own table, and the facial-hair decal is tinted with
    // the hair colour (spot file, avatar_tools/COLOURS.md).
    //
    // Face paint is the one sheet left out: it is painted art, not a tint mask, so
    // it keeps its coloured plate. Eyes are here through a two-part mask - one eye
    // sheet paints the iris (tinted) and the sclera (a fixed near-white), and a
    // single coverage mask cannot tell them apart, so the iris has its own light and
    // specular masks (avatar_tools/make_eye_masks.py) drawn over the plate.
    readonly property var colourSlots: ({
        "12_eyebrows": "eyebrow",
        "15_face": "eye",
        "17_eye-shadow": "eye_shadow",
        "45_facial-hair": "facial_hair",
        "50_hair": "hair",
        // The body and head are one plate baked in a skin tone; the skin screen
        // replaces that tone through a mask of the silhouette minus the face
        // features (avatar_tools/make_skin_mask.py).
        "10_body": "skin",
        // The mouths are the one face slot with no assets in the pack - 18_mouth
        // has 26 names and no textures - so the mouth drawn on the head is the
        // descriptor's own "Smirk Mouth", masked once (see bake_pack_face.py,
        // MOUTH_CATEGORY) and tinted from the lips table.
        "18_mouth": "lips"
    })

    function colourSlot(categoryId) {
        var slot = colourSlots[categoryId]
        return slot === undefined ? "" : slot
    }

    function paletteFor(categoryId) {
        var slot = colourSlot(categoryId)
        if (slot === "")
            return []
        var table = colourTables.palettes[slot]
        return table === undefined ? [] : table
    }

    // The stock tone of a slot the user has never touched. Every table's index 0 is
    // the game's first entry and that is what the stock avatar wears - except the
    // body: tinting the skin mask with skin[1] #d7aa71 reproduces the baked body
    // plate to a mean of 2.8/255 (p95 5.0), so the stock skin is index 1, and using
    // 0 would paint the stock avatar dark brown the first time it is drawn.
    readonly property var colourDefaults: ({ "skin": 1, "eye": 3 })

    function colourIndex(slot) {
        var v = colours[slot]
        if (v === undefined)
            v = colourDefaults[slot]
        return v === undefined ? 0 : v
    }

    // The heading over the swatches is the game's own screen title, read from the
    // editor image's localisation table (editor_xui_strings.json -> colour_labels):
    // "Hair Color", "Eye Shadow Color", "Skin Color and Body", ... The fallback,
    // "Color", is the generic label from the same table.
    readonly property var colourTitles: ({
        "skin": "Skin Color and Body",
        "skin-short": "Skin Color",
        "hair": "Hair Color",
        "lips": "Lip Color",
        "eye": "Eye Color",
        "eyebrow": "Eyebrow Color",
        "eye_shadow": "Eye Shadow Color",
        "eyeliner": "Eyeliner Color",
        "facial_hair": "Facial Hair Color",
        "facial_feature": "Facial Feature Color"
    })

    function colourTitle(slot) {
        var t = colourTitles[slot]
        return t === undefined ? "Color" : t
    }

    function colourHex(slot) {
        var table = colourTables.palettes[slot]
        if (table === undefined || table.length === 0)
            return "#ffffff"
        var i = Math.max(0, Math.min(table.length - 1, colourIndex(slot)))
        return table[i]
    }

    // The tint mask for this item, if one was baked. It is what the colour is
    // applied to, so an item with a mask is drawn through TintedMask.qml instead
    // of its coloured plate.
    // The body's mask is the skin mask, not the item's own silhouette, so it is
    // drawn as its own layer on top of the plate rather than replacing it.
    function skinMaskUrl() {
        var folders = packMasks.folders
        for (var i = 0; i < folders.length; ++i) {
            if (folders[i].id !== "10_body")
                continue
            if ((folders[i].files || []).indexOf("skin.png") < 0)
                return ""
            return style.itemUrl(style.dirUrl(Qt.resolvedUrl("pack_plates_mask/"), "10_body"),
                                 "skin.png")
        }
        return ""
    }

    // The iris, as the two terms the renderer shades with: light and specular
    // (make_eye_masks.py). The eye keeps its plate - the sclera, the lashes and the
    // stock iris are on it - and the tinted iris is drawn over the iris alone.
    function eyeMaskUrl(name) {
        return maskFile("15_face_iris", name)
    }

    function eyeSpecUrl(name) {
        return maskFile("15_face_iris_spec", name)
    }

    function maskFile(folderId, name) {
        var folders = packMasks.folders
        for (var i = 0; i < folders.length; ++i) {
            if (folders[i].id !== folderId)
                continue
            if ((folders[i].files || []).indexOf(name) < 0)
                return ""
            return style.itemUrl(style.dirUrl(Qt.resolvedUrl("pack_plates_mask/"), folderId), name)
        }
        return ""
    }

    function maskUrl(categoryId, name) {
        // The body keeps its own plate and gets the skin layer above it, so the
        // generic mask path must not claim it: 10_body's mask is a silhouette of
        // the whole body and tinting it would paint over the eyes and mouth.
        if (categoryId === "10_body")
            return ""
        // The eye keeps its plate for the same kind of reason: its mask is the iris
        // alone, drawn as its own layer over the plate (rebuildLayers), so replacing
        // the plate with it would drop the whites and the lashes.
        if (categoryId === "15_face")
            return ""
        // The masks are baked in the male frame. A head sheet is the same picture on
        // either body, but a hairstyle is a mesh whose plate is framed by the body
        // it was baked with, so a female avatar keeps its coloured hair plates until
        // the female masks exist.
        if (categoryId === "50_hair" && gender !== "male")
            return ""
        var folders = packMasks.folders
        for (var i = 0; i < folders.length; ++i) {
            if (folders[i].id !== categoryId)
                continue
            if ((folders[i].files || []).indexOf(name) < 0)
                return ""
            return style.itemUrl(style.dirUrl(Qt.resolvedUrl("pack_plates_mask/"), categoryId), name)
        }
        return ""
    }

    // The head's own mouth, as a tint mask: pack_plates_mask/18_mouth holds the one
    // mouth this build draws, because the pack ships no mouth textures.
    function mouthMaskUrl() {
        var folders = packMasks.folders
        for (var i = 0; i < folders.length; ++i) {
            if (folders[i].id !== "18_mouth")
                continue
            var files = folders[i].files || []
            if (files.length === 0)
                return ""
            return style.itemUrl(style.dirUrl(Qt.resolvedUrl("pack_plates_mask/"), "18_mouth"),
                                 files[0])
        }
        return ""
    }

    function setColour(slot, index) {
        if (slot === "")
            return
        var next = {}
        for (var key in colours)
            next[key] = colours[key]
        next[slot] = index
        colours = next
        saveColours()
        rebuildLayers()
    }

    function rebuildLayers() {
        var out = []
        for (var i = 0; i < categories.length; ++i) {
            var c = categories[i]
            var name = state[c.id]
            if (!name)
                continue
            // Face items are UV sheets, not body plates, so they used to be left
            // out of the 2D stack entirely. They have overlay plates now
            // (bake_pack_face.py diffs the head with and without the sheet), so
            // they join the stack; without a plate they still cannot be drawn.
            if (usePackArt && isPackDecal(c.id) && !hasPlates(c.id))
                continue
            // A sheet with no plate for this item would draw its strip thumbnail
            // over the whole avatar, so leave it out instead.
            if (usePackArt && isPackDecal(c.id) && plateUrl(c.id, name) === "")
                continue
            var url = style.itemUrl(c.path, name)
            var tint = ""
            if (usePackArt) {
                // In pack mode a layer is a plate or a tint mask, never the
                // strip's own art: `pack_art` holds 160x108 cards for the tiles,
                // and `c.path` points there for every category the plates did not
                // cover. Drawing one painted the card across the avatar - measured
                // on 18_mouth (`pack_art/18_mouth/curvy-mouth.png`), 71_nose,
                // 72_ears and 73_head-shape, all untinted, one failed layer per
                // pick. The mouths have no textures in the pack at all and the
                // shapes are geometry morphs a layer stack cannot show; both are
                // drawn elsewhere (the stock smirk mask tinted below, and the 3D
                // sets) or not at all.
                var slot = colourSlot(c.id)
                var masked = slot === "" ? "" : maskUrl(c.id, name)
                if (masked !== "") {
                    url = masked
                    tint = colourHex(slot)
                } else {
                    var plate = plateUrl(c.id, name)
                    if (plate === "")
                        continue
                    url = plate
                }
            }
            out.push({ url: url, z: c.z, id: c.id, tint: tint })
        }
        // Skin sits directly over the body plate and under everything else, so the
        // features that the mask leaves out keep showing the plate's own pixels and
        // the brow, eye and mouth layers repaint on top of them.
        if (usePackArt) {
            var skinMask = skinMaskUrl()
            if (skinMask !== "")
                out.push({ url: skinMask, z: style.layerOrder("10_body") + 0.5,
                           id: "10_body_skin", tint: colourHex("skin") })
        }
        // The iris sits on the eye plate rather than instead of it: the sheet's
        // sclera, lashes and stock iris are already drawn, and only the iris changes
        // with the colour. Two terms go with it - light and specular - which is what
        // TintedMask.qml's specSource is for.
        if (usePackArt && state["15_face"]) {
            var iris = eyeMaskUrl(state["15_face"])
            if (iris !== "")
                out.push({ url: iris, spec: eyeSpecUrl(state["15_face"]),
                           z: style.layerOrder("15_face") + 0.5, id: "15_face_iris",
                           tint: colourHex("eye") })
        }
        // The mouth is painted into the head, not picked from the pack, so it is not
        // one of the categories the loop above walks. Its mask goes in at its own
        // slot order (18, above the eye shadow at 17 and under facial hair at 45).
        if (usePackArt) {
            var lips = mouthMaskUrl()
            if (lips !== "")
                out.push({ url: lips, z: style.layerOrder("18_mouth"), id: "18_mouth",
                           tint: colourHex("lips") })
        }
        out.sort(function (a, b) { return a.z - b.z })
        _layers = out
        _layerVersion++
    }

    onCategoriesChanged: rebuildLayers()

    // ---- whole-avatar actions -------------------------------------------

    function clearAll() {
        var next = {}
        if (bodyCategory && state[bodyCategory.id])
            next[bodyCategory.id] = state[bodyCategory.id]
        state = next
        rebuildLayers()
    }

    function randomize() {
        var next = {}
        for (var i = 0; i < categories.length; ++i) {
            var c = categories[i]
            if (bodyCategory && c.id === bodyCategory.id) {
                if (state[c.id])
                    next[c.id] = state[c.id]
                continue
            }
            var files = c.files || []
            if (!files.length)
                continue
            next[c.id] = files[Math.floor(Math.random() * files.length)]
        }
        state = next
        rebuildLayers()
    }

    function currentState() {
        var copy = {}
        for (var key in state)
            copy[key] = state[key]
        return copy
    }

    function loadState(saved) {
        var next = {}
        for (var key in saved)
            if (saved[key])
                next[key] = saved[key]
        var hadAvatar = false
        for (var k in next)
            if (next[k])
                hadAvatar = true
        state = next
        categoryIndex = 0
        // loadState runs after rebuildCategories, so seedOutfit has already done
        // its pass - but this assignment may have just wiped it with a host's
        // empty state. Re-seed only in that case, so a fresh avatar opens on the
        // choose screen already dressed like the 3D turntable, and a saved
        // wardrobe is never touched.
        if (!hadAvatar)
            seedOutfit()
        fillBodyIfEmpty()
        rebuildLayers()
        // A player with nothing saved is choosing a starting point, which is
        // the screen the original opens on the first time.
        if (hadAvatar) {
            screen = "menu"
        } else {
            rebuildPresets()
            chooseIndex = 0
            screen = "choose"
        }
    }

    function save() {
        saveRequested(currentState())
    }

    function capturePortrait() {
        // Whichever view is live is the one worth saving; with no baked frames
        // the 3D stage has nothing to grab, so 2D still answers.
        var target = (renderMode === "3d" && stage3d.available) ? stage3d : stage
        target.capture(function (result) {
            if (result)
                portraitReady(result)
        })
    }

    // ---- input -----------------------------------------------------------

    Keys.onPressed: function (event) {
        // 3 toggles the render mode on every screen that shows the avatar.
        if (event.key === Qt.Key_3 && screen !== "choose") {
            renderMode = renderMode === "3d" ? "2d" : "3d"
            event.accepted = true
            return
        }

        // The menu is its own screen: up/down move between the five plates and
        // accept activates one. In the closet, cancel goes back to the menu.
        if (screen === "choose") {
            var chit = true
            switch (event.key) {
            case Qt.Key_Right: chooseIndex = Math.min(presets.length - 1, chooseIndex + 1); break
            case Qt.Key_Left:  chooseIndex = Math.max(0, chooseIndex - 1); break
            case Qt.Key_Return:
            case Qt.Key_Enter:
            case Qt.Key_Space: applyPreset(chooseIndex); break
            case Qt.Key_X:     rebuildPresets(); break
            case Qt.Key_Escape:
            case Qt.Key_Backspace: setScreen("menu"); break
            default: chit = false
            }
            event.accepted = chit
            return
        }

        if (screen === "features") {
            var fhit = true
            switch (event.key) {
            case Qt.Key_Right: featureIndex = Math.min(featureItems.length - 1, featureIndex + 1); break
            case Qt.Key_Left:  featureIndex = Math.max(0, featureIndex - 1); break
            case Qt.Key_Down:  featureIndex = Math.min(featureItems.length - 1, featureIndex + 2); break
            case Qt.Key_Up:    featureIndex = Math.max(0, featureIndex - 2); break
            case Qt.Key_Return:
            case Qt.Key_Enter:
            case Qt.Key_Space: activateFeature(featureIndex); break
            case Qt.Key_Escape:
            case Qt.Key_Backspace: setScreen("menu"); break
            default: fhit = false
            }
            event.accepted = fhit
            return
        }

        if (screen === "menu") {
            var hit = true
            switch (event.key) {
            case Qt.Key_Down:
                menuIndex = Math.min(menuItems.length - 1, menuIndex + 1); break
            case Qt.Key_Up:
                menuIndex = Math.max(0, menuIndex - 1); break
            case Qt.Key_Return:
            case Qt.Key_Enter:
            case Qt.Key_Space:
                activateMenuItem(menuIndex); break
            case Qt.Key_Escape:
            case Qt.Key_Backspace:
                backRequested(); break
            default:
                hit = false
            }
            event.accepted = hit
            return
        }

        // Inside Pegasus, controller and keyboard bindings are checked through
        // api.keys; outside it the raw keys below are used.
        if (typeof api !== "undefined" && api.keys) {
            if (api.keys.isCancel(event)) {
                setScreen("menu")
                event.accepted = true
                return
            }
            if (api.keys.isAccept(event)) {
                event.accepted = true
                return
            }
        }

        var handled = true
        switch (event.key) {
        case Qt.Key_Right:   moveItem(1); break
        case Qt.Key_Left:    moveItem(-1); break
        case Qt.Key_Down:    selectCategory(categoryIndex + 1); break
        case Qt.Key_Up:      selectCategory(categoryIndex - 1); break
        case Qt.Key_Space:   randomize(); break
        case Qt.Key_S:       save(); break
        case Qt.Key_P:       capturePortrait(); break
        case Qt.Key_R:       clearAll(); break
        case Qt.Key_Escape:
        case Qt.Key_Backspace: setScreen("menu"); break
        default:             handled = false
        }
        event.accepted = handled
    }

    // ---- chrome ----------------------------------------------------------

    // Artwork taken out of the original avatareditor.xex: the closet's dark
    // panel behind the avatar and the banner that sits under the item strip.
    // The editor's own studio backdrops: the menu's plain one and the closet's
    // with the halo pattern, both 1280x720 out of avatareditor.xex.
    Image {
        anchors.fill: parent
        source: Qt.resolvedUrl(root.screen === "menu"
                               ? "assets/_ui/xex/background_menu.png"
                               : "assets/_ui/xex/background_closet.png")
        fillMode: Image.PreserveAspectCrop
        smooth: true
    }

    // Keeps the pale backdrop from washing out the plates and the legend.
    Rectangle {
        anchors.fill: parent
        color: root.screen === "menu" ? "#400b1320" : "#330b1320"
    }

    Item {
        id: header
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.leftMargin: 26
        anchors.rightMargin: 26
        anchors.topMargin: 16
        height: 40

        Text {
            id: headline
            // The menu shows whose avatar this is; each other screen names the
            // plate that opened it, which is what the original's labels say.
            text: root.screen === "menu" ? root.gamerTag
                  : (root.screen === "features" ? "Change My Features"
                  : (root.screen === "choose" ? root.title : "Change My Clothes"))
            color: style.ink
            font.family: style.titleFamily
            font.pixelSize: 27
            font.weight: Font.DemiBold
            style: Text.Raised
            styleColor: "#40000000"
        }
    }

    Image {
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        height: sourceSize.height * (width / sourceSize.width)
        source: Qt.resolvedUrl("assets/_ui/xex/banner_bottom.png")
        fillMode: Image.Stretch
        smooth: true
        opacity: 0.7
    }

    // The closet's own legend row. The A/B/X/Y art is the original editor's
    // (avatareditor.xex), and putting it down here also keeps our hints clear
    // of the button bar Pegasus draws along the bottom of the screen.
    Row {
        id: legend
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        anchors.leftMargin: 26
        anchors.bottomMargin: 12
        spacing: 22

        // The source's control scheme, not a button bar: scnEditor registers an
        // A-button override and a refresh-random (X) override, and the legend
        // scene draws the A/B/X/Y glyphs. Each entry is also clickable, so a
        // mouse user keeps the same four actions.
        Repeater {
            model: root.legendModel

            Item {
                width: entry.width
                height: entry.height

                Row {
                    id: entry
                    spacing: 8
                    opacity: hit.containsMouse ? 1.0 : 0.82
                    Behavior on opacity { NumberAnimation { duration: 100 } }

                    Image {
                        source: Qt.resolvedUrl(modelData.glyph)
                        height: 22
                        width: height
                        fillMode: Image.PreserveAspectFit
                        smooth: true
                    }
                    Text {
                        text: modelData.label
                        // Literals: style.* is not resolved on a delegate's first
                        // bind, which logs "Unable to assign [undefined]" for
                        // every entry of the Repeater.
                        color: "#ffffff"
                        font.family: "Segoe UI"
                        font.pixelSize: 13
                        anchors.verticalCenter: parent.verticalCenter
                    }
                }

                MouseArea {
                    id: hit
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        switch (modelData.action) {
                        case "save":       root.save(); break
                        case "back":       if (root.screen !== "menu") root.setScreen("menu")
                                           else root.backRequested(); break
                        case "randomize":  root.randomize(); break
                        case "portrait":   root.capturePortrait(); break
                        case "menuSelect":
                            if (root.screen === "choose") root.applyPreset(root.chooseIndex)
                            else if (root.screen === "features") root.activateFeature(root.featureIndex)
                            else root.activateMenuItem(root.menuIndex)
                            break
                        case "presets":    root.rebuildPresets(); break
                        }
                        root.forceActiveFocus()
                    }
                }
            }
        }
    }

    // A face item is drawn as a tint mask, so the closet grows the game's colour
    // panel while a category with a palette behind it is open. The panel is the
    // retail one: a 3 x 3 page of nine chips inside the editor's own frame art
    // (assets/_ui/xex/named/colour_palette_skin_selected.png and ..._unselected.png,
    // both 128 x 128, extracted from avatareditor.xex), filled from the measured
    // table in Colours.qml.
    //
    // The frame art ships with placeholder chips -- its pixels are design-tool
    // constants (#00bff3, #f26522, #c69c6d in the option frame; #e5cab9, #8c5d2e in
    // the skin frame), 37 to 284 away from any entry in the tables -- so the art is
    // used for the frame and the disc, and the chips are painted from the table.
    // The chip pitch below is the art's own: its nine chips sit in the box
    // (22,22)-(106,104) of the 128 px sheet, i.e. 28 x 27.33 apart.
    Item {
        id: colourRow
        readonly property string slot: root.currentCategory
                                       ? root.colourSlot(root.currentCategory.id) : ""
        readonly property var table: root.paletteFor(root.currentCategory
                                                     ? root.currentCategory.id : "")
        readonly property int perPage: 9
        readonly property int pageCount: Math.max(1, Math.ceil(table.length / perPage))
        property int page: 0
        readonly property real artSize: 88
        readonly property real artScale: artSize / 128
        visible: root.screen === "closet" && slot !== ""
        anchors.left: rail.right
        anchors.leftMargin: 14
        anchors.bottom: strip.top
        anchors.bottomMargin: 6
        width: 210
        height: visible ? 96 : 0

        onSlotChanged: page = 0

        Text {
            id: colourLabel
            anchors.left: parent.left
            anchors.top: parent.top
            anchors.topMargin: 4
            text: root.colourTitle(colourRow.slot)
            color: style.ink
            font.family: "Segoe UI"
            font.pixelSize: 13
        }

        Item {
            id: colourPage
            width: colourRow.artSize
            height: colourRow.artSize
            anchors.left: parent.left
            anchors.top: colourLabel.bottom
            anchors.topMargin: 2

            Image {
                anchors.fill: parent
                source: Qt.resolvedUrl("assets/_ui/xex/named/colour_palette_skin_selected.png")
                smooth: true
                fillMode: Image.PreserveAspectFit
            }

            Repeater {
                model: colourRow.perPage

                Rectangle {
                    readonly property int colourPos: colourRow.page * colourRow.perPage + index
                    // Chips are drawn at the art's own pitch so they cover the
                    // placeholder chips painted into the frame sheet; anything
                    // smaller leaves slivers of their mock colours showing.
                    x: (22 + (index % 3) * 28) * colourRow.artScale
                    y: (22 + Math.floor(index / 3) * 27.34) * colourRow.artScale
                    width: 28 * colourRow.artScale
                    height: 27.34 * colourRow.artScale
                    radius: 1
                    visible: colourPos < colourRow.table.length
                    color: visible ? colourRow.table[colourPos] : "transparent"
                    border.width: colourPos === root.colourIndex(colourRow.slot) ? 2 : 0
                    border.color: "#ffffff"

                    MouseArea {
                        anchors.fill: parent
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            root.setColour(colourRow.slot, colourPos)
                            root.forceActiveFocus()
                        }
                    }
                }
            }
        }

        Text {
            anchors.left: colourPage.right
            anchors.leftMargin: 10
            anchors.top: colourPage.top
            anchors.topMargin: 2
            visible: colourRow.pageCount > 1
            text: (colourRow.page + 1) + "/" + colourRow.pageCount
            color: style.inkDim
            font.family: "Segoe UI"
            font.pixelSize: 12
        }

        Row {
            anchors.left: colourPage.right
            anchors.leftMargin: 10
            anchors.top: colourPage.top
            anchors.topMargin: 22
            spacing: 14
            visible: colourRow.pageCount > 1

            Text {
                text: "\u2039"
                color: colourRow.page > 0 ? style.ink : style.inkDim
                font.pixelSize: 20

                MouseArea {
                    anchors.fill: parent
                    anchors.margins: -6
                    cursorShape: Qt.PointingHandCursor
                    onClicked: if (colourRow.page > 0) {
                                   colourRow.page -= 1
                                   root.forceActiveFocus()
                               }
                }
            }

            Text {
                text: "\u203a"
                color: colourRow.page < colourRow.pageCount - 1 ? style.ink : style.inkDim
                font.pixelSize: 20

                MouseArea {
                    anchors.fill: parent
                    anchors.margins: -6
                    cursorShape: Qt.PointingHandCursor
                    onClicked: if (colourRow.page < colourRow.pageCount - 1) {
                                   colourRow.page += 1
                                   root.forceActiveFocus()
                               }
                }
            }
        }
    }

    ItemStrip {
        id: strip
        visible: root.screen === "closet"
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.leftMargin: 26
        anchors.rightMargin: 26
        anchors.bottom: legend.top
        anchors.bottomMargin: 10
        height: 172

        model: items
        bodySource: (root.bodyCategory && root.currentCategory
                     && root.currentCategory.id === root.bodyCategory.id)
                    ? "" : root.bodySource()
        allowNone: !(root.bodyCategory && root.currentCategory
                     && root.currentCategory.id === root.bodyCategory.id)
        selectedName: {
            void root._layerVersion
            var id = root.currentCategory ? root.currentCategory.id : ""
            return root.state[id] || ""
        }
        onPicked: function (fileName) {
            if (root.currentCategory)
                root.setItem(root.currentCategory.id, fileName)
            root.forceActiveFocus()
        }
    }

    CategoryRail {
        id: rail
        visible: root.screen === "closet"
        anchors.left: parent.left
        anchors.top: header.bottom
        anchors.bottom: strip.top
        anchors.leftMargin: 26
        anchors.topMargin: 10
        anchors.bottomMargin: 10
        // Fixed, not left to implicitWidth: an implicit width can collapse to
        // the widest label and squeeze every pill on a small or odd host.
        width: Math.max(168, Math.min(232, Math.round(root.width * 0.15)))
        categories: root.categories
        currentIndex: root.categoryIndex
        accentColor: root.accentColor
        onActivated: root.selectCategory(index)
    }

    AvatarStage {
        id: stage
        idle: root.idleBob
        // The avatar keeps the left half on the menu and moves right of the
        // rail in the closet, exactly where each screen puts it.
        x: root.screen === "closet" ? rail.x + rail.width + 14 : (root.screen === "features" ? 14 : 40)
        y: 64
        width: root.screen === "closet" ? root.width - x - 26
             : (root.screen === "features" ? 286 : (root.screen === "choose" ? 0 : 470))
        height: root.screen === "closet" ? 430 : (root.screen === "choose" ? 0 : 592)
        // Hidden in 3D: the baked frames have a transparent background, so a
        // visible 2D stage would show through them as a ghost avatar.
        visible: root.screen !== "choose" && root.renderMode !== "3d"
        layers: root.layers
        showShadow: root.modelShadows
        emptyHint: root.categories.length === 0
                   ? "No item folders found in " + root.assetsFolder
                   : ""
    }

    AvatarStage3D {
        id: stage3d
        objectName: "stage3d"
        x: stage.x
        y: stage.y
        width: stage.width
        height: stage.height
        visible: root.screen !== "choose" && root.renderMode === "3d"
        idle: root.idleBob
        baseFolder: root.assetsFolder + "3d/"
        // bake_animated.py pictures the stock outfit and hairstyle, and set.json
        // in assets/3d/animated names the set folder that look resolves to
        // ("turntable/jacket-with-sweater"). The stage plays the animated frames
        // only while the player is wearing exactly that, so no guard is needed
        // here - the one this replaces compared against the default hairstyle's
        // own turntable, which the stock outfit's set always outranks, so the
        // animated bake was never shown in pack mode.
        animatedFolder: root.assetsFolder + "3d/animated/"
        variant: root.stageVariant
        defaultVariant: "turntable"
    }

    // model_shadows switch, beside the 2D/3D one. Both stages draw the shadow
    // under the avatar's feet, so it stays available in either mode.
    Rectangle {
        id: shadowSwitch
        visible: root.screen !== "choose"
        anchors.right: modeSwitch.left
        anchors.rightMargin: 8
        y: modeSwitch.y
        height: modeSwitch.height
        width: shadowLabel.implicitWidth + 24
        radius: height / 2
        color: shadowHover.containsMouse ? "#2b3a4e" : "#1b2634"
        border.width: 1
        border.color: root.modelShadows ? root.accentColor : "#43546e"

        Text {
            id: shadowLabel
            anchors.centerIn: parent
            text: "Shadow"
            color: root.modelShadows ? root.accentColor : "#ffffff"
            font.family: "Segoe UI"
            font.pixelSize: 13
            font.weight: Font.DemiBold
        }

        MouseArea {
            id: shadowHover
            anchors.fill: parent
            hoverEnabled: true
            cursorShape: Qt.PointingHandCursor
            onClicked: root.toggleShadows()
        }
    }

    // Male / female, as the console's editor offers it: the pack marks every
    // item with one gender, and the two bodies have their own bakes.
    Rectangle {
        id: genderSwitch
        visible: root.screen !== "choose"
        anchors.right: modeSwitch.left
        anchors.rightMargin: 8
        y: 18
        width: 92
        height: 26
        radius: 13
        color: genderHover.containsMouse ? "#2b3a4e" : "#1b2634"
        border.width: 1
        border.color: root.gender === "female" ? root.accentColor : "#43546e"

        Text {
            anchors.centerIn: parent
            text: root.gender === "female" ? "Female" : "Male"
            color: root.gender === "female" ? root.accentColor : "#ffffff"
            font.family: "Segoe UI"
            font.pixelSize: 13
            font.weight: Font.DemiBold
        }

        MouseArea {
            id: genderHover
            anchors.fill: parent
            hoverEnabled: true
            cursorShape: Qt.PointingHandCursor
            onClicked: root.gender = root.gender === "female" ? "male" : "female"
        }
    }

    // 2D / 3D switch. It shows the live mode rather than an icon for the other
    // one, and stays hidden on the choose screen, which has no avatar.
    Rectangle {
        id: modeSwitch
        visible: root.screen !== "choose"
        anchors.right: parent.right
        anchors.rightMargin: 18
        y: 18
        width: 74
        height: 26
        radius: 13
        color: modeHover.containsMouse ? "#2b3a4e" : "#1b2634"
        border.width: 1
        border.color: root.renderMode === "3d" ? root.accentColor : "#43546e"

        Text {
            anchors.centerIn: parent
            text: root.renderMode === "3d" ? "3D" : "2D"
            color: root.renderMode === "3d" ? root.accentColor : "#ffffff"
            font.family: "Segoe UI"
            font.pixelSize: 13
            font.weight: Font.DemiBold
        }

        MouseArea {
            id: modeHover
            anchors.fill: parent
            hoverEnabled: true
            cursorShape: Qt.PointingHandCursor
            onClicked: root.renderMode = root.renderMode === "3d" ? "2d" : "3d"
        }
    }


    // The ten starting avatars, on the row the source's VECT chunk lays out.
    Item {
        id: choose
        visible: root.screen === "choose"
        anchors.left: parent.left
        anchors.right: parent.right
        height: 220
        y: 150

        Item {
            anchors.fill: parent

            Repeater {
                model: root.presets

                Item {
                    x: root.chooseSlots[index]
                    y: 0
                    width: 86
                    height: 168

                    Rectangle {
                        anchors.fill: parent
                        radius: 8
                        color: index === root.chooseIndex ? "#c6f473" : "#38485e"
                        border.width: index === root.chooseIndex ? 2 : 1
                        border.color: index === root.chooseIndex ? "#c6f473" : "#43546e"
                    }

                    AvatarThumb {
                        anchors.fill: parent
                        anchors.margins: 4
                        state: modelData
                        // The presets carry plate names in pack mode (the plates
                        // are the only art registered to the body frame), so the
                        // thumbnail reads the same folder the 2D stage draws from.
                        assetsFolder: root.usePackArt ? root.plateFolder()
                                                      : root.assetsFolder
                    }

                    MouseArea {
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            root.chooseIndex = index
                            root.applyPreset(index)
                            root.forceActiveFocus()
                        }
                    }
                }
            }
        }
    }

    // Change My Features: the six tiles, two columns of three, on the right so
    // the avatar stays visible while you change it.
    Item {
        id: features
        visible: root.screen === "features"
        anchors.top: header.bottom
        anchors.topMargin: 18
        anchors.right: parent.right
        anchors.rightMargin: 20
        width: 620
        height: 510

        Grid {
            columns: 2
            spacing: 10

            Repeater {
                model: root.featureItems

                Item {
                    width: 300
                    height: 167

                    Image {
                        anchors.fill: parent
                        source: Qt.resolvedUrl("assets/_ui/xex/feature_" + modelData.key
                                               + (index === root.featureIndex
                                                  ? "_selected" : "_unselected") + ".png")
                        fillMode: Image.Stretch
                        smooth: true
                        // A tile with no folder behind it reads as unavailable,
                        // the way the source greys out what you do not own.
                        opacity: root.categoryIndexFor(modelData.label) >= 0 ? 1.0 : 0.55
                    }

                    Text {
                        anchors.left: parent.left
                        anchors.leftMargin: 12
                        anchors.bottom: parent.bottom
                        anchors.bottomMargin: 8
                        text: modelData.label
                        color: index === root.featureIndex ? "#20300a" : "#f4f7fa"
                        font.family: "Segoe UI"
                        font.pixelSize: 15
                        font.weight: Font.DemiBold
                    }

                    MouseArea {
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            root.featureIndex = index
                            root.activateFeature(index)
                            root.forceActiveFocus()
                        }
                    }
                }
            }
        }
    }

    // The menu plates. 512x128 each, drawn at 400x100: the baked icon sits in
    // the left fifth, which is where the label starts.
    Item {
        id: menu
        visible: root.screen === "menu"
        anchors.top: header.bottom
        anchors.topMargin: 18
        anchors.right: parent.right
        anchors.rightMargin: 26
        width: 400
        height: menuColumn.height

        Column {
            id: menuColumn
            spacing: 4

            Repeater {
                model: root.menuItems

                Item {
                    width: 400
                    height: 100

                    Image {
                        anchors.fill: parent
                        source: Qt.resolvedUrl("assets/_ui/xex/plate_" + modelData.key
                                               + (index === root.menuIndex
                                                  ? "_selected" : "_unselected") + ".png")
                        fillMode: Image.Stretch
                        smooth: true
                    }

                    Text {
                        anchors.left: parent.left
                        anchors.leftMargin: 134
                        anchors.right: parent.right
                        anchors.rightMargin: 16
                        anchors.verticalCenter: parent.verticalCenter
                        text: modelData.label
                        color: index === root.menuIndex ? "#20300a" : "#f4f7fa"
                        font.family: "Segoe UI"
                        font.pixelSize: 19
                        font.weight: Font.DemiBold
                        elide: Text.ElideRight
                    }

                    MouseArea {
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            root.menuIndex = index
                            root.activateMenuItem(index)
                            root.forceActiveFocus()
                        }
                    }
                }
            }
        }
    }

    function saveColours() {
        if (typeof api === "undefined" || !api.memory)
            return
        api.memory.set("cfg.avatarColours", JSON.stringify(colours))
    }

    function loadColours() {
        if (typeof api === "undefined" || !api.memory)
            return
        var raw = api.memory.get("cfg.avatarColours")
        if (!raw)
            return
        try {
            var saved = JSON.parse(raw)
            if (saved && typeof saved === "object")
                colours = saved
        } catch (e) {
        }
    }

    function toggleShadows() {
        modelShadows = !modelShadows
        saveShadows()
    }

    function saveShadows() {
        if (typeof api === "undefined" || !api.memory)
            return
        api.memory.set("cfg.avatarShadows", modelShadows ? "1" : "0")
    }

    Component.onCompleted: {
        if (typeof api !== "undefined" && api.memory) {
            var saved = api.memory.get("cfg.avatarShadows")
            if (saved === "0") modelShadows = false
            else if (saved === "1") modelShadows = true
        }
        loadColours()
        rebuildCategories()
    }
}
